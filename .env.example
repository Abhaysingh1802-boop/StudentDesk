# Copy these variables into your host's environment settings. Do not commit .env.
NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/studentdesk
JWT_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=StudentDesk <your-verified-email@example.com>
CLIENT_URL=https://your-frontend-domain.example
